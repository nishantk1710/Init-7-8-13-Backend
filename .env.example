# Copy to .env for local development. .env is gitignored -- never commit real values.
#
# Three settings need a value from you before the seed will run:
#   DATABASE_URL, STORAGE_URL  -- both Azure, both unreachable from a laptop
# Everything else works as shipped. See README, "Setup, from a fresh clone".

APP_ENV=local
APP_NAME=spares-ai-backend
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Browser origin allowed to call this API. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000


# ===========================================================================
# Azure SQL -- SET THIS
# ===========================================================================

# sqldb-aicom on sql-vzi-aicom-nonprod-san. The ONLY place the database is
# named. Local Postgres was a stand-in while VZI's database was provisioned and
# has been removed -- a postgresql:// URL here is now refused with an
# explanation rather than half-working.
#
#   mssql+pyodbc://<user>:<password>@sql-vzi-aicom-nonprod-san.database.windows.net:1433/sqldb-aicom
#     ?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
#
# driver, Encrypt and TrustServerCertificate are not optional. Without
# Encrypt=yes Azure SQL refuses the connection; with TrustServerCertificate=yes
# it connects while trusting anything, which defeats the point.
#
# pyodbc additionally needs the system-level "ODBC Driver 18 for SQL Server".
# It ships with the App Service Python image. A local machine has to install it
# separately -- it is not a pip package.
#
# REACHABILITY. This server has public network access disabled and is fronted by
# pe-sqlvziaicomnonprod-sqlserver, so it answers only from inside
# vnet-vzi-aicom-nonprod-san. From a laptop it will time out. That is the
# network behaving as designed; run `python -m app.checkup` from the App
# Service SSH console to test it for real.
#
# Empty is valid: the app and /api/health start with no database. /api/ready
# reports "not_configured" until this is set.
DATABASE_URL=

# Log every SQL statement. Local debugging only -- very noisy during a seed.
DATABASE_ECHO=false

# Seconds to wait for a connection before giving up. Deliberately short so an
# unreachable database fails fast with a clear message instead of hanging --
# which, outside the VNet, is the normal case.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Replace a pooled connection before Azure SQL cuts it at around 30 minutes
# idle, so the replacement happens on our schedule rather than inside someone's
# request.
DATABASE_POOL_RECYCLE_SECONDS=1500


# ===========================================================================
# Azure Data Lake -- SET THIS
# ===========================================================================

# Where the SAP data delivery lives: the stvziaicomnonprod account, reached
# through pe-stvziaicomnonprod-dfs. The adapter is chosen from the scheme, and
# abfss:// is the only one supported -- the local-folder adapter has been
# removed along with local Postgres.
#
#   abfss://<container>@stvziaicomnonprod.dfs.core.windows.net/<path>
#
# The path should CONTAIN both delivery folders, not be either one:
#
#   <STORAGE_URL>/
#   |-- KPI 02 Data Extract/Tables/     24 SAP table extracts
#   `-- Resources Shared - Rohit/       ZMM065 x2 + 30 Day GR Report
#
# The manifest keys carry those prefixes, so the folder names must match
# exactly, including case. Anything else in the container is ignored: the
# loader reads only the 27 files the manifest names.
#
# AUTHENTICATION is by managed identity (DefaultAzureCredential): the App
# Service's identity when deployed, your `az login` session locally. The
# identity needs "Storage Blob Data Reader" on the account, or every read is a
# 403 that looks like a missing file.
#
# Run `python -m app.seed --list` after setting this: it verifies every file is
# present and touches no database.
STORAGE_URL=

# Optional, and a fallback rather than the design. Only for a machine with
# neither a managed identity nor an az login. Prefer a role assignment.
AZURE_STORAGE_ACCOUNT_KEY=

# Key Vault, for `python -m app.checkup` ONLY -- no code reads secrets from it.
#
# Secrets reach this app as App Service Key Vault references: App Service
# resolves @Microsoft.KeyVault(SecretUri=...) into an ordinary environment
# variable before the process starts, so no Key Vault SDK is needed here. The
# cost of that (correct) design is that the app never talks to the vault and so
# cannot report whether it is reachable -- which Anish asked us to confirm.
# Setting this lets checkup probe it directly, using the same managed identity.
#
#   https://kv-vzi-aicom-nonprod.vault.azure.net/
KEY_VAULT_URL=


# ===========================================================================
# AI service layer (W1.5) -- optional, works out of the box
# ===========================================================================
#
# Which provider is plugged in. Business logic never reads this; it calls
# get_llm(). Defaults to a deterministic stub, so the app, the tests and a
# developer laptop all work with no provider and no credentials at all.
#
#   stub     deterministic, no network (default)
#   foundry  Microsoft Foundry
#   openai   any OpenAI-compatible endpoint
LLM_PROVIDER=stub

# Shared across providers.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Foundry ---------------------------------------------------------------
# VZI's provider. GPT-4o and gpt-4o-mini are live (confirmed 15-Sep).
#
#   LLM_PROVIDER=foundry
#   FOUNDRY_ENDPOINT=https://oai-vzi-aicom-nonprod-san.services.ai.azure.com/openai/v1
#   FOUNDRY_DEPLOYMENT=gpt-4o
#   FOUNDRY_DEPLOYMENT_FAST=gpt-4o-mini
#
# NOTE THE ENDPOINT SHAPE. Ending in /openai/v1 means the newer
# OpenAI-compatible surface: the model goes in the request BODY, auth is a
# Bearer token, and there is NO api-version. The classic Azure OpenAI surface
# puts the deployment in the URL with an api-version instead. Appending the
# classic path to a /openai/v1 endpoint gives a doubled /openai/ and a 404 that
# reads like a permissions problem.
#
# FOUNDRY_API_STYLE=auto infers this from the endpoint. Both shapes are
# implemented and tested; override only for an endpoint that breaks convention.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_STYLE=auto

# The cheaper deployment for high-volume formulaic work. Which job uses which is
# decided in app/core/model_registry.py, not at the call site. Leave empty to
# use FOUNDRY_DEPLOYMENT for everything.
FOUNDRY_DEPLOYMENT_FAST=

# Only used by the classic (deployments) style. Ignored on the v1 surface.
FOUNDRY_API_VERSION=2024-10-21

# --- The alternate provider ------------------------------------------------
# Any OpenAI-compatible endpoint. Exists so the abstraction is exercised by two
# genuinely different wire shapes rather than assumed to work.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# ===========================================================================
# Reserved for future phases. All optional -- the application, the liveness
# endpoint and the test suite all start and pass with every one of these empty.
# ===========================================================================

# --- SAP / CPI -------------------------------------------------------------
#
# SAP is never reached directly. Every call goes to ONE CPI iFlow URL carrying
# the real OData request as APIPath and APIQuery parameters, so there are no
# per-service OData URLs to configure.
#
# Named CPI_*, not SAP_*, because that is what they are -- and what
# data-generator/.env has always called them. Copy the same four values.
#
# All optional: the application, /api/health and the test suite all work with
# these empty. Only the live SAP tests (`pytest -m live`) need them.
CPI_BASE_URL=
CPI_TOKEN_URL=
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=

# The iFlow path appended to CPI_BASE_URL. Rarely changes.
CPI_PATH=/http/SAPECC/OdataConsumption

# Rows per page, and per-request timeout in seconds.
CPI_PAGE_SIZE=1000
CPI_TIMEOUT_SECONDS=120

# Path to a CA bundle, for a network that terminates TLS with a corporate
# certificate. Symptom: CERTIFICATE_VERIFY_FAILED, or curl reporting
# CRYPT_E_NO_REVOCATION_CHECK. Export the corporate root and point this at it.
# There is deliberately no option to disable verification -- on an intercepting
# network that does not "make it work", it makes every call trust anything.
CPI_CA_BUNDLE=


# ===========================================================================
# Criticality (W3.4) -- optional, works out of the box
# ===========================================================================
#
# Where material criticality is read from. I07, I08 and I13 never read this
# setting; they call get_criticality_source(). Switching sources is a config
# change, not a code change.
#
#   zmm065    the delivered ZMM065 aging reports (default)
#   zzcritic  MARC-ZZCRITIC, falling back to zmm065
#
# ZZCRITIC is the preferred source in principle: a MARC change document proves
# the field exists in SAP. But the CPI service does not expose it -- the
# MaterialPlantSet projection carries twelve properties and no Z-append -- and
# its contents are unconfirmed. Selecting it today is safe: every lookup falls
# through to ZMM065 and is marked as a fallback rather than failing silently.
#
# Both sources read the seeded raw tables, so DATABASE_URL must be set and
# `python -m app.seed --all` must have run.
CRITICALITY_SOURCE=zmm065

# Azure Entra ID (not implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
