# Copy to .env for local development. .env is gitignored -- never commit real values.
#
# Three settings need a value from you before the seed will run:
#   POSTGRES_PASSWORD, DATABASE_URL, STORAGE_URL
# Everything else works as shipped. See README, "Setup, from a fresh clone".

APP_ENV=local
APP_NAME=spares-ai-backend
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Browser origin allowed to call this API. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000


# ===========================================================================
# Local Postgres -- SET THESE
# ===========================================================================

# Read by compose.yaml when the container is first created, and again by
# DATABASE_URL below. The two must agree, or the app connects with the wrong
# password to a database that was created with a different one.
#
# Applied ONLY to an empty data volume. Changing it later has no effect on an
# existing container -- `podman compose down -v` first, which deletes the data.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=spares_ai

# The SQLAlchemy URL, and the ONLY place the database is named. Moving between
# local Postgres and the deployed database is a change to this line, not to any
# code -- the adapter comes from the URL scheme.
#
#   local:  postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/spares_ai
#   cloud:  postgresql+psycopg://<user>:<pw>@<host>.postgres.database.azure.com:5432/spares_ai?sslmode=require
#
# Use 127.0.0.1, NOT localhost. On Windows localhost resolves to IPv6 ::1 first
# while podman/docker forwards IPv4 only, so every connection stalls on the IPv6
# attempt before falling back -- measured here at ~19s per connect against 0.34s,
# taking the test suite from 4m27s to 1.9s. It works either way, which is what
# makes it hard to spot.
#
# Empty is valid: the app and /api/health start without a database. /api/ready
# will report "not_configured" until this is set.
DATABASE_URL=

# Log every SQL statement. Local debugging only -- very noisy during a seed.
DATABASE_ECHO=false


# ===========================================================================
# Object storage -- SET THIS
# ===========================================================================

# Where the SAP data delivery lives. A plain filesystem path or a file:// URL
# locally; an abfss:// URL once the Azure Data Lake adapter exists. The adapter
# is chosen from the scheme, so switching is this line and nothing else.
#
# Point it at the folder that CONTAINS both delivery folders, not at either one:
#
#   <STORAGE_URL>/
#   |-- KPI 02 Data Extract/Tables/     24 SAP table extracts
#   `-- Resources Shared - Rohit/       ZMM065 x2 + 30 Day GR Report
#
# The manifest keys carry those prefixes, so the folder names must match exactly
# -- including case, on a case-sensitive filesystem. Anything else in the tree is
# ignored: the loader reads only the 27 files the manifest names.
#
# Example (Windows, forward slashes are fine and spaces need no quoting):
#   STORAGE_URL=C:/Users/<you>/OneDrive - <org>/Desktop/Vedanta
#
# Do NOT copy the ~800 MB delivery inside this repo. The tree is OneDrive-synced
# and there is no ignore rule for a data directory. Read it where it already is.
#
# Run `python -m app.seed --list` after setting this: it verifies every file is
# present, and touches no database.
STORAGE_URL=


# ===========================================================================
# Reserved for future phases. All optional -- the application, the liveness
# endpoint and the test suite all start and pass with every one of these empty.
# ===========================================================================

# --- SAP / CPI -------------------------------------------------------------
#
# SAP is never reached directly. Every call goes to ONE CPI iFlow URL carrying
# the real OData request as APIPath and APIQuery parameters, so there are no
# per-service OData URLs to configure.
#
# Named CPI_*, not SAP_*, because that is what they are -- and what
# data-generator/.env has always called them. Copy the same four values.
#
# All optional: the application, /api/health and the test suite all work with
# these empty. Only the live SAP tests (`pytest -m live`) need them.
CPI_BASE_URL=
CPI_TOKEN_URL=
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=

# The iFlow path appended to CPI_BASE_URL. Rarely changes.
CPI_PATH=/http/SAPECC/OdataConsumption

# Rows per page, and per-request timeout in seconds.
CPI_PAGE_SIZE=1000
CPI_TIMEOUT_SECONDS=120

# Path to a CA bundle, for a network that terminates TLS with a corporate
# certificate. Symptom: CERTIFICATE_VERIFY_FAILED, or curl reporting
# CRYPT_E_NO_REVOCATION_CHECK. Export the corporate root and point this at it.
# There is deliberately no option to disable verification -- on an intercepting
# network that does not "make it work", it makes every call trust anything.
CPI_CA_BUNDLE=

# Azure Entra ID (not implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Initiative 13: End-to-End Spares Utilisation Tracking. All optional --
# defaults match the current SOP/VZI ruling. See app/core/config.py.
# ---------------------------------------------------------------------------

# CSV-backed SAP/platform dataset root (data-generator/generated by default).
I13_DATA_DIR=data-generator/generated

# Current VZI OAR material-scope ruling (MARC.DISMM), comma-separated.
I13_OAR_MRP_TYPES=ND,PD
I13_MIN_MAX_MRP_TYPES=VB

# W6.2 reservation source: "mock" (synthetic ReservationItemSet.csv, tied to
# the same synthetic PR/PO/GR/GI dataset) or "postgres" (real RESB rows
# already extracted into raw_resb -- requires DATABASE_URL). See
# app/integrations/sap/postgres_reservation.py.
I13_RESERVATION_SOURCE=mock

# Aging bands (days since last goods movement).
I13_AGING_FAST_MAX_DAYS=365
I13_AGING_SLOW_MAX_DAYS=730

# Trailing consumption window (months) used across WATCH/aging/reclassification.
I13_CONSUMPTION_WINDOW_MONTHS=12

# 30-day goods-received-not-issued exception threshold.
I13_GR_NOT_ISSUED_THRESHOLD_DAYS=30

# Grace period (days) after a consumption plan's window before PLAN_BREACH.
I13_PLAN_BREACH_GRACE_DAYS=14

# SOP indicator for OAR -> Min-Max reclassification review.
I13_RECLASS_MIN_CONSUMPTION_COUNT=4

# Reconciliation tolerance (%) for local validation against reference reports.
I13_RECONCILIATION_TOLERANCE_PCT=5.0
