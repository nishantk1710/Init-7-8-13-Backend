# Copy to .env for local development. .env is gitignored -- never commit real values.
#
# Three settings need a value from you before the seed will run:
#   DATABASE_URL, STORAGE_URL  -- both Azure, both unreachable from a laptop
# Everything else works as shipped. See README, "Setup, from a fresh clone".

APP_ENV=local
APP_NAME=spares-ai-backend
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Browser origin allowed to call this API. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000


# ===========================================================================
# Azure SQL -- SET THIS
# ===========================================================================

# sqldb-aicom on sql-vzi-aicom-nonprod-san. The ONLY place the database is
# named. Local Postgres was a stand-in while VZI's database was provisioned and
# has been removed -- a postgresql:// URL here is now refused with an
# explanation rather than half-working.
#
#   mssql+pyodbc://<user>:<password>@sql-vzi-aicom-nonprod-san.database.windows.net:1433/sqldb-aicom
#     ?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
#
# driver, Encrypt and TrustServerCertificate are not optional. Without
# Encrypt=yes Azure SQL refuses the connection; with TrustServerCertificate=yes
# it connects while trusting anything, which defeats the point.
#
# pyodbc additionally needs the system-level "ODBC Driver 18 for SQL Server".
# It ships with the App Service Python image. A local machine has to install it
# separately -- it is not a pip package.
#
# REACHABILITY. This server has public network access disabled and is fronted by
# pe-sqlvziaicomnonprod-sqlserver, so it answers only from inside
# vnet-vzi-aicom-nonprod-san. From a laptop it will time out. That is the
# network behaving as designed; run `python -m app.checkup` from the App
# Service SSH console to test it for real.
#
# Empty is valid: the app and /api/health start with no database. /api/ready
# reports "not_configured" until this is set.
DATABASE_URL=

# Log every SQL statement. Local debugging only -- very noisy during a seed.
DATABASE_ECHO=false

# Seconds to wait for a connection before giving up. Deliberately short so an
# unreachable database fails fast with a clear message instead of hanging --
# which, outside the VNet, is the normal case.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Replace a pooled connection before Azure SQL cuts it at around 30 minutes
# idle, so the replacement happens on our schedule rather than inside someone's
# request.
DATABASE_POOL_RECYCLE_SECONDS=1500


# ===========================================================================
# Azure Data Lake -- SET THIS
# ===========================================================================

# Where the SAP data delivery lives: the stvziaicomnonprod account, reached
# through pe-stvziaicomnonprod-dfs. The adapter is chosen from the scheme, and
# abfss:// is the only one supported -- the local-folder adapter has been
# removed along with local Postgres.
#
#   abfss://<container>@stvziaicomnonprod.dfs.core.windows.net/<path>
#
# The path should CONTAIN both delivery folders, not be either one:
#
#   <STORAGE_URL>/
#   |-- KPI 02 Data Extract/Tables/     24 SAP table extracts
#   `-- Resources Shared - Rohit/       ZMM065 x2 + 30 Day GR Report
#
# The manifest keys carry those prefixes, so the folder names must match
# exactly, including case. Anything else in the container is ignored: the
# loader reads only the 27 files the manifest names.
#
# AUTHENTICATION is by managed identity (DefaultAzureCredential): the App
# Service's identity when deployed, your `az login` session locally. The
# identity needs "Storage Blob Data Reader" on the account, or every read is a
# 403 that looks like a missing file.
#
# Run `python -m app.seed --list` after setting this: it verifies every file is
# present and touches no database.
STORAGE_URL=

# Optional, and a fallback rather than the design. Only for a machine with
# neither a managed identity nor an az login. Prefer a role assignment.
AZURE_STORAGE_ACCOUNT_KEY=

# Key Vault, for `python -m app.checkup` ONLY -- no code reads secrets from it.
#
# Secrets reach this app as App Service Key Vault references: App Service
# resolves @Microsoft.KeyVault(SecretUri=...) into an ordinary environment
# variable before the process starts, so no Key Vault SDK is needed here. The
# cost of that (correct) design is that the app never talks to the vault and so
# cannot report whether it is reachable -- which Anish asked us to confirm.
# Setting this lets checkup probe it directly, using the same managed identity.
#
#   https://kv-vzi-aicom-nonprod.vault.azure.net/
KEY_VAULT_URL=


# ===========================================================================
# AI service layer (W1.5) -- optional, works out of the box
# ===========================================================================
#
# Which provider is plugged in. Business logic never reads this; it calls
# get_llm(). Defaults to a deterministic stub, so the app, the tests and a
# developer laptop all work with no provider and no credentials at all.
#
#   stub     deterministic, no network (default)
#   foundry  Microsoft Foundry
#   openai   any OpenAI-compatible endpoint
LLM_PROVIDER=stub

# Shared across providers.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Foundry ---------------------------------------------------------------
# VZI's provider. Only gpt-4o is deployed (confirmed 15-Sep -- gpt-4o-mini
# returns 404 DeploymentNotFound on this resource, and the team has confirmed
# it is not deployed for now). So leave FOUNDRY_DEPLOYMENT_FAST empty or equal
# to gpt-4o; pointing it at mini 404s every job the registry routes to 'fast'.
#
#   LLM_PROVIDER=foundry
#   FOUNDRY_ENDPOINT=https://oai-vzi-aicom-nonprod-san.services.ai.azure.com/openai/v1
#   FOUNDRY_DEPLOYMENT=gpt-4o
#   FOUNDRY_DEPLOYMENT_FAST=
#
# NOTE THE ENDPOINT SHAPE. Ending in /openai/v1 means the newer
# OpenAI-compatible surface: the model goes in the request BODY, auth is a
# Bearer token, and there is NO api-version. The classic Azure OpenAI surface
# puts the deployment in the URL with an api-version instead. Appending the
# classic path to a /openai/v1 endpoint gives a doubled /openai/ and a 404 that
# reads like a permissions problem.
#
# FOUNDRY_API_STYLE=auto infers this from the endpoint. Both shapes are
# implemented and tested; override only for an endpoint that breaks convention.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_STYLE=auto

# The cheaper deployment for high-volume formulaic work. Which job uses which is
# decided in app/core/model_registry.py, not at the call site. Leave empty to
# use FOUNDRY_DEPLOYMENT for everything.
#
# Empty is correct today: there is no second deployment. The registry's tiering
# is therefore inert -- every tier resolves to gpt-4o -- which costs nothing and
# keeps the intent recorded. Set this the day a cheaper deployment exists.
FOUNDRY_DEPLOYMENT_FAST=

# Only used by the classic (deployments) style. Ignored on the v1 surface.
FOUNDRY_API_VERSION=2024-10-21

# --- The alternate provider ------------------------------------------------
# Any OpenAI-compatible endpoint. Exists so the abstraction is exercised by two
# genuinely different wire shapes rather than assumed to work.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# ===========================================================================
# Reserved for future phases. All optional -- the application, the liveness
# endpoint and the test suite all start and pass with every one of these empty.
# ===========================================================================

# --- SAP / CPI -------------------------------------------------------------
#
# SAP is never reached directly. Every call goes to ONE CPI iFlow URL carrying
# the real OData request as APIPath and APIQuery parameters, so there are no
# per-service OData URLs to configure.
#
# Named CPI_*, not SAP_*, because that is what they are -- and what
# data-generator/.env has always called them. Copy the same four values.
#
# All optional: the application, /api/health and the test suite all work with
# these empty. Only the live SAP tests (`pytest -m live`) need them.
CPI_BASE_URL=
CPI_TOKEN_URL=
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=

# The iFlow path appended to CPI_BASE_URL. Rarely changes.
CPI_PATH=/http/SAPECC/OdataConsumption

# Rows per page, and per-request timeout in seconds.
CPI_PAGE_SIZE=1000
CPI_TIMEOUT_SECONDS=120

# Path to a CA bundle, for a network that terminates TLS with a corporate
# certificate. Symptom: CERTIFICATE_VERIFY_FAILED, or curl reporting
# CRYPT_E_NO_REVOCATION_CHECK. Export the corporate root and point this at it.
# There is deliberately no option to disable verification -- on an intercepting
# network that does not "make it work", it makes every call trust anything.
CPI_CA_BUNDLE=


# ===========================================================================
# Criticality (W3.4) -- optional, works out of the box
# ===========================================================================
#
# Where material criticality is read from. I07, I08 and I13 never read this
# setting; they call get_criticality_source(). Switching sources is a config
# change, not a code change.
#
#   zmm065    the delivered ZMM065 aging reports (default)
#   zzcritic  MARC-ZZCRITIC, falling back to zmm065
#
# ZZCRITIC is the preferred source in principle: a MARC change document proves
# the field exists in SAP. But the CPI service does not expose it -- the
# MaterialPlantSet projection carries twelve properties and no Z-append -- and
# its contents are unconfirmed. Selecting it today is safe: every lookup falls
# through to ZMM065 and is marked as a fallback rather than failing silently.
#
# Both sources read the seeded raw tables, so DATABASE_URL must be set and
# `python -m app.seed --all` must have run.
CRITICALITY_SOURCE=zmm065

# Azure Entra ID (not implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=


# ===========================================================================
# Initiative 08 -- Refurbishable Spares Tracking (W5.1, W5.2)
# ===========================================================================
#
# Every business rule in I08 is here rather than in code, and there is a test
# that keeps it that way (tests/test_i8_rules.py). All of them have working
# defaults -- you do not need to set any of this to run the module.
#
# The reason it matters most: the repair-PO convention below is PENDING SAP
# TEAM CONFIRMATION. If they come back and say the item category is 'L' and not
# '3', that must be one line in this file, not a code change and a redeploy.

# The 80-series convention. Comma-separated, so a second repairable series can
# be added without touching any code.
I8_SERIES_PREFIXES=80

# A repairable material number is exactly this long once leading zeros are
# stripped. The guard that stops the bare string '80' matching the prefix.
I8_MATERIAL_NUMBER_LENGTH=10

# PSTYP -- the repair-PO filter. Applied in Python, never as an OData $filter:
# SAP accepts a filter on this property, answers HTTP 200 and ignores it.
I8_REPAIR_ITEM_CATEGORY=3

# BSART -- corroborating only, NEVER a gate. 455 of the 1,225 repair lines have
# no PO header in the July extract, and inner-joining to read this value drops
# every one of them.
I8_REPAIR_DOC_TYPE=ZREP

# Days past the schedule-line delivery date before a line counts as overdue.
# Confirmed by the team lead on 21-Sep.
I8_OVERDUE_GRACE_DAYS=7

# NOTE: there is no I8_LEAD_TIME_GRACE_DAYS, and that is the ruling.
#
# The lead-time check -- aging past MARC.PLIFZ -- gets NO grace period. Asked
# explicitly on 21-Sep, answered "No not needed". Grace exists because a
# schedule-line date is a commitment somebody made and a few days' slack is
# courtesy; a planned delivery time is already an average with slack baked into
# it, and discounting it twice just moves a threshold nobody agreed to.
#
# The lead time itself is not configurable either: it is MARC.PLIFZ per material
# and plant, in calendar days, measured PO to received -- the same field and span
# Initiative 07 uses, confirmed with Khushi. Two initiatives reading different
# fields would report different turnarounds for the same part.

# The date all aging is measured from. Blank means today.
#
# Set it for a demo or the UAT pack. The extract is a July-2026 snapshot, so by
# wall clock every open line is already weeks old and every number moves each
# morning. Pinning it makes the output explainable and reproducible.
I8_REFERENCE_DATE=

# NOTE: I8_CRITICALITY_SOURCE IS GONE, deliberately (15-Sep).
#
# Criticality moved to the shared W3.4 module and is configured ONCE, globally,
# by CRITICALITY_SOURCE above -- not per initiative. A setting that only I08
# obeyed would be a way to make one initiative disagree with the other two about
# the same material, which is the exact failure W3.4 exists to prevent.
# GET /api/i8/config reports which source actually answered.

# --- W5.3: the condition-to-repair attestation ------------------------------

# The controlled fault-category list the attestation form offers, and validates
# against. VZI's vocabulary, not ours -- it was not delivered with the extracts,
# so this starting set is drawn from the fault language already present in the
# EKPO short texts. It WILL change, and it must be one line here rather than a
# code change, a review and a redeploy.
I8_FAULT_CATEGORIES=BEARING_FAILURE,SEAL_LEAK,WEAR,IMPACT_DAMAGE,ELECTRICAL_FAULT,CORROSION,VIBRATION_DAMAGE,OVERHEATING,CONTAMINATION,UNKNOWN

# How far from a repair line's raised date an attestation may sit and still
# count as covering it. Symmetric around that date.
#
# PROPOSAL, NOT A CONFIRMED RULE -- open question 3. Material + plant + a date
# window is the only key both sides share: an attestation is made against a
# physical part coming off a machine, and nothing in that moment carries the
# purchase-order number the part will later be repaired under.
#
# Raising this does NOT make historical exceptions clear in a useful way. The
# extract is a frozen July-2026 snapshot, so an attestation recorded today is
# months outside every line's window by design -- see
# app/initiatives/i8/demo_seed.py before reaching for a bigger number.
I8_ATTESTATION_WINDOW_DAYS=30

# The date the attestation control starts applying. Blank means no cutover.
#
# THE DATE IS STILL MISSING; THE RULING IS NOT. MISSING_ATTESTATION fires on all
# 1,225 historical repair lines because the control did not exist when they were
# raised. Asked about that on 20-Sep, the team lead answered "on them can we show
# before Spares Automation" -- so a line raised before this date is LABELLED
# rather than accused: it keeps the exception, gains `preAutomation`, drops to
# info severity, and leaves `actionable` while staying in `total`.
#
# Left blank deliberately rather than guessed. A cutover set too early accuses
# historical lines; set too late it silently forgives real misses on the other
# side of it. Both failures are invisible in the output. Whoever owns go-live
# supplies the date and this becomes one line.
I8_ATTESTATION_CUTOVER_DATE=

# --- W5.5: coding candidates -------------------------------------------------

# The repair language that makes a free-text PO line worth screening. Substring
# stems, matched case-insensitively, each regex-escaped before it reaches SQL.
#
# Measured over the 82,718 free-text lines on 15-Sep:
#   repair 271, refurb 24, recon 3, service exchange 3, overhaul 2, rebuild 2,
#   rotable 0.
#
# 'rotable' is kept on purpose: it is standard vocabulary for exactly this class
# of part, it costs nothing, and a keyword that matches nothing today is
# evidence about the data rather than a bug.
I8_REPAIR_LANGUAGE=repair,refurb,overhaul,recon,rebuild,service exchange,rotable

# Plant code -> display name. No plant-name table was delivered, so only the
# two plants this repository documents are listed; any other code is displayed
# as its code rather than as a guess.
I8_PLANT_NAMES=1300=Black Mountain,1500=Gamsberg

# API paging. 788 open repair lines will not render in one response.
I8_DEFAULT_PAGE_SIZE=50
I8_MAX_PAGE_SIZE=500


# ---------------------------------------------------------------------------
# Initiative 13: End-to-End Spares Utilisation Tracking. All optional --
# defaults match the current SOP/VZI ruling. See app/core/config.py.
# ---------------------------------------------------------------------------

# CSV-backed SAP/platform dataset root (data-generator/generated by default).
I13_DATA_DIR=data-generator/generated

# Current VZI OAR material-scope ruling (MARC.DISMM), comma-separated.
I13_OAR_MRP_TYPES=ND,PD
I13_MIN_MAX_MRP_TYPES=VB

# Aging bands (days since last goods movement).
I13_AGING_FAST_MAX_DAYS=365
I13_AGING_SLOW_MAX_DAYS=730

# Trailing consumption window (months) used across WATCH/aging/reclassification.
I13_CONSUMPTION_WINDOW_MONTHS=12

# 30-day goods-received-not-issued exception threshold.
I13_GR_NOT_ISSUED_THRESHOLD_DAYS=30

# Grace period (days) after a consumption plan's window before PLAN_BREACH.
I13_PLAN_BREACH_GRACE_DAYS=14

# SOP indicator for OAR -> Min-Max reclassification review.
I13_RECLASS_MIN_CONSUMPTION_COUNT=4

# Reconciliation tolerance (%) for local validation against reference reports.
I13_RECONCILIATION_TOLERANCE_PCT=5.0

# ---------------------------------------------------------------------------
# W7 -- the reservation-time assistant (shared by Initiative 08 and 13)
# ---------------------------------------------------------------------------

# The session reference a planner reads off the assistant and types into SAP.
#
# Ten characters, because that is what Bednr holds -- Edm.String(10). Wempf,
# the only exposed alternative, is 12, so 10 is safe either way. The width is
# configuration so pointing at a different field later is a change here rather
# than a migration on audit history.
#
# The alphabet is Crockford base32: no I, L, O or U, so nothing is confusable,
# and the last character is a checksum so a mistyped reference fails
# immediately instead of matching nothing. See app/assistant/ids.py.
ASSISTANT_SESSION_ID_LENGTH=10
ASSISTANT_SESSION_ID_PREFIX=S

# How long a minted session stays current.
#
# OUR default, not a VZI ruling -- open question 11. Expiry is REPORTED and
# never enforced: the reservation is already saved in SAP and this platform
# cannot write back, so treating an expired-but-present reference as
# non-compliant would raise an exception nobody could ever clear.
ASSISTANT_SESSION_TTL_HOURS=72

# Whether a model writes the sentence around facts we have already computed.
#
# OFF by default, deliberately. Every number the assistant states is already a
# field we hold, so the arithmetic is never the model's job -- but both FRSs
# say "responses generated through the provider-agnostic LLM layer", which
# makes this a visible deviation that needs sign-off before anything depends
# on it. When on, a failed or unconfigured provider degrades silently to the
# deterministic sentence, and the stub provider's placeholder text is refused
# by name so it can never reach a planner as advice.
ASSISTANT_NARRATIVE_ENABLED=false

# Reason categories offered when somebody justifies a decision.
#
# PLACEHOLDERS. Both FRSs say "reason category plus free text" and neither
# lists the categories (open question 9). Configuration rather than an enum so
# the day VZI supplies its own list is an edit here, not a migration.
ASSISTANT_JUSTIFICATION_REASON_CATEGORIES=URGENT_BREAKDOWN,NO_SUITABLE_REPAIRABLE,REPAIR_TOO_SLOW,PLANNED_MAINTENANCE,SAFETY_CRITICAL,PROJECT_WORK,OTHER

# Whether the free-text box answers anything.
#
# When on it routes to a small, explicit set of intents over the DETERMINISTIC
# read models -- no model is involved in that path at all. It is not a general
# question-answering agent over the dataset, and that remains a separate scope
# decision that has not been taken.
ASSISTANT_FREE_TEXT_INTENTS_ENABLED=true

# --- I13 FR-3: the quantity suggestion --------------------------------------
#
# The FRS names all three of these as configuration and gives numbers for none
# of them, so these are OUR defaults until VZI confirms them (open question
# 10). They are served with every suggestion so the number can be argued with
# rather than taken.

# How many months of cover a reservation may take a material to. Suggest
# enough to reach it, never more.
I13_QUANTITY_COVER_CEILING_MONTHS=12

# Look-back window for the average monthly consumption the suggestion divides
# by. Deliberately separate from I13_CONSUMPTION_WINDOW_MONTHS even though both
# default to 12: that one is a reporting choice and this one is an arithmetic
# input, and retuning one must not silently move the other.
I13_QUANTITY_LOOKBACK_MONTHS=12

# Below this many consumption events in the look-back window, NO suggestion is
# made at all. An average built from one issue is not an average, and a
# confident number derived from it is worse than no number.
I13_QUANTITY_MIN_HISTORY_CONSUMPTIONS=3
