# Copy to .env for local development. .env is gitignored -- never commit real values.

APP_ENV=local
APP_NAME=spares-ai-backend
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Browser origin allowed to call this API. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Reserved for future phases. All optional -- the application (and the health
# endpoint) starts and runs correctly with every one of these left empty.
# ---------------------------------------------------------------------------

# Azure SQL (not implemented)
AZURE_SQL_CONNECTION_STRING=

# SAP integration (not implemented; auth mechanism not yet confirmed by SAP/VZI)
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# Azure Entra ID (not implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
