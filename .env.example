# Copy to .env for local development. .env is gitignored -- never commit real values.

APP_ENV=local
APP_NAME=spares-ai-backend
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

# Browser origin allowed to call this API. Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Reserved for future phases. All optional -- the application (and the health
# endpoint) starts and runs correctly with every one of these left empty.
# ---------------------------------------------------------------------------

# --- Local Postgres (compose.yaml reads these) ------------------------------
# Used by `podman compose up -d` to create the container, and by DATABASE_URL
# below to connect to it. Keep the two consistent.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=spares_ai

# Database. SQLAlchemy URL -- the ONLY place the database is named, so moving
# between local and deployed is a config change, not a code change.
# Local Postgres (podman/docker):
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/spares_ai
#
# Use 127.0.0.1, NOT localhost. On Windows localhost resolves to IPv6 ::1 first
# while podman/docker forwards IPv4 only, so every connection stalls on the IPv6
# attempt before falling back -- measured here as ~19s per connect versus 0.34s.
# It works either way; one is 50x slower.
# Left empty here on purpose: the app and the liveness endpoint start without it.
DATABASE_URL=

# Log every SQL statement. Local debugging only.
DATABASE_ECHO=false

# Object storage. A plain filesystem path or a file:// URL locally; an
# abfss:// URL once the Azure Data Lake adapter exists. The adapter is chosen
# from the scheme, so this is the whole cutover.
#   STORAGE_URL=D:/vzi-data/extracts
# Point it at the SAP extract folder to read the July workbooks in place.
# Do NOT copy 800 MB of extracts inside this repo: it is OneDrive-synced and
# there is no ignore rule for a data directory.
STORAGE_URL=

# SAP integration (not implemented; auth mechanism not yet confirmed by SAP/VZI)
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# Azure Entra ID (not implemented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
